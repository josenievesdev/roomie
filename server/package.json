{
  "name": "roomie-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Servidor multijugador de Roomie (Node + Socket.io, AvatarState autoritativo)",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "db:check": "node --env-file-if-exists=.env src/db/check.ts"
  },
  "dependencies": {
    "socket.io": "^4.8.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
